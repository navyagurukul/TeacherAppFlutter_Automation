# Copy to .env and adjust for your machine. Values here are the defaults.

# Appium server (start with: appium)
APPIUM_SERVER=http://127.0.0.1:4723

# Path to the APK you provide. Relative paths are resolved from qa_teacherapp_automation/.
APK_PATH=apps/teacher.apk

# App identifiers (already correct for this app; override only if the build changes).
APP_PACKAGE=com.OritSciencesPrivateLimited.EnglishGurukul.teacher
APP_ACTIVITY=com.example.teacher_app.MainActivity

# Target device. Leave DEVICE_NAME as-is for a single running emulator/device;
# set UDID to pin a specific one when several are connected (adb devices).
DEVICE_NAME=Android Emulator
UDID=
PLATFORM_VERSION=

# true  = keep app data between tests (faster, stays logged in)
# false = clear app state on every session (clean, but slower)
NO_RESET=true
FULL_RESET=false

# Seconds Appium waits when locating an element before failing.
IMPLICIT_WAIT=10

# Slack Incoming Webhook URL for the daily report (run_daily.py). Create one at
# https://api.slack.com/messaging/webhooks and paste it here.
SLACK_WEBHOOK_URL=

# Daily report options (run_daily.py).
#   DAILY_INCLUDE_UI  1/true = always run the Login+Tabs UI areas, 0/false = never;
#                     leave blank to auto-detect (run them when a device+Appium are up).
#   APP_VERSION       override the app version shown in the report; blank = auto
#                     (login-screen capture -> adb -> APK -> pubspec.yaml).
DAILY_INCLUDE_UI=
APP_VERSION=
